{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && (auth.token.admin === true || root.child('admins').child(auth.uid).child('enabled').val() === true)",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",

        ".validate": "!newData.exists() || newData.child('email').isString()",

        "role": {
          ".validate": "newData.val() === null || newData.val() === 'customer'"
        },

        "active": {
          ".validate": "auth.token.admin === true || !data.exists()"
        },

        "suspended": {
          ".validate": "auth.token.admin === true"
        },

        "balance": {
          ".validate": "newData.isNumber() && (auth.token.admin === true || data.val() === newData.val() || (!data.exists() && newData.val() === 0))"
        }
      }
    },

    "admins": {
      ".read": "auth != null && (auth.token.admin === true || root.child('admins').child(auth.uid).child('enabled').val() === true)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true || root.child('admins').child(auth.uid).child('enabled').val() === true)",
        ".write": "auth != null && (auth.token.admin === true || root.child('admins').child(auth.uid).child('enabled').val() === true)",
        ".validate": "auth != null && newData.child('role').val() === 'admin' && newData.child('enabled').val() === true"
      }
    },

    "accountNumbers": {
      ".read": "auth != null",

      "$number": {
        ".write": "auth != null && (auth.token.admin === true || data.val() === auth.uid || (!data.exists() && newData.val() === auth.uid))",
        ".validate": "newData.isString() && newData.val().length <= 128"
      }
    },

    "transactions": {
      ".read": "auth != null && (auth.token.admin === true || root.child('admins').child(auth.uid).child('enabled').val() === true)",

      "$txId": {
        ".read": "auth != null && (auth.token.admin === true || (query.orderByChild === 'uid' && query.equalTo === auth.uid) || data.child('uid').val() === auth.uid)",

        ".write": "auth != null && (auth.token.admin === true || (!data.exists() && newData.child('uid').val() === auth.uid))",

        "uid": {
          ".validate": "auth != null && (auth.token.admin === true && newData.val() === data.child('uid').val() || (!data.exists() && newData.val() === auth.uid))"
        },

        "status": {
          ".validate": "auth != null && (auth.token.admin === true || newData.val() === 'pending' || (!data.exists() && newData.val() === 'approved'))"
        }
      }
    },

    "settings": {
      ".read": "auth != null",
      "deposit": {
        ".write": "auth != null && auth.token.admin === true"
      }
    }
  }
}
